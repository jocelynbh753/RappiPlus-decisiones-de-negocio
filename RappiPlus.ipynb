   "source": [
    "\n",
    "# Retención por cohortes\n",
    "# ======================\n",
    "query_cohort_retention_final = '''\n",
    "WITH cohortes AS (\n",
    "    SELECT \n",
    "        id_usuario,\n",
    "        DATE_TRUNC('week', CAST(fecha_registro AS DATE)) AS cohorte_semana\n",
    "    FROM users\n",
    "),\n",
    "\n",
    "actividad AS (\n",
    "    SELECT\n",
    "        id_usuario,\n",
    "        DATE_TRUNC('week', CAST(fecha_actividad AS DATE)) AS semana_actividad\n",
    "    FROM user_activity\n",
    "    WHERE activo = 1\n",
    "),\n",
    "\n",
    "cohorte_actividad AS (\n",
    "    SELECT\n",
    "        c.id_usuario,\n",
    "        c.cohorte_semana,\n",
    "        a.semana_actividad,\n",
    "        EXTRACT(week FROM a.semana_actividad) \n",
    "            - EXTRACT(week FROM c.cohorte_semana)\n",
    "            + 52 * (EXTRACT(year FROM a.semana_actividad) - EXTRACT(year FROM c.cohorte_semana))\n",
    "            AS semana_relativa\n",
    "    FROM cohortes c\n",
    "    JOIN actividad a USING (id_usuario)\n",
    "),\n",
    "\n",
    "resumen AS (\n",
    "    SELECT\n",
    "        cohorte_semana,\n",
    "        COUNT(DISTINCT c.id_usuario) AS clientes_iniciales,\n",
    "        COUNT(DISTINCT c.id_usuario) FILTER (WHERE semana_relativa = 1) AS retenido_w1,\n",
    "        COUNT(DISTINCT c.id_usuario) FILTER (WHERE semana_relativa = 2) AS retenido_w2,\n",
    "        COUNT(DISTINCT c.id_usuario) FILTER (WHERE semana_relativa = 3) AS retenido_w3\n",
    "    FROM cohorte_actividad c\n",
    "    GROUP BY cohorte_semana\n",
    ")\n",
    "\n",
    "SELECT\n",
    "    cohorte_semana,\n",
    "    clientes_iniciales,\n",
    "    retenido_w1,\n",
    "    retenido_w2,\n",
    "    retenido_w3,\n",
    "    ROUND(retenido_w1::numeric / NULLIF(clientes_iniciales, 0), 3) AS semana_1,\n",
    "    ROUND(retenido_w2::numeric / NULLIF(clientes_iniciales, 0), 3) AS semana_2,\n",
    "    ROUND(retenido_w3::numeric / NULLIF(clientes_iniciales, 0), 3) AS semana_3\n",
    "FROM resumen\n",
    "ORDER BY cohorte_semana;\n",
    "'''\n",
    "# Ejecutar la consulta\n",
    "cohorte_final = pd.read_sql(query_cohort_retention_final, con=engine)\n",
    "cohorte_final\n"
   ]
  },
