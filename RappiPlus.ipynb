    "# PARTE 2: Conversiones\n",
    "# ======================\n",
    "query_conversion = '''\n",
    "WITH funnel AS (\n",
    "    SELECT DISTINCT \n",
    "        id_usuario,\n",
    "        CASE\n",
    "            WHEN nombre_evento = 'first_visit' THEN 'first_visit'\n",
    "            WHEN nombre_evento = 'add_to_cart' THEN 'add_to_cart'\n",
    "            WHEN nombre_evento = 'add_payment_info' THEN 'add_payment_info'\n",
    "            WHEN nombre_evento = 'purchase' THEN 'purchase'\n",
    "        END AS etapa\n",
    "    FROM events\n",
    "    WHERE nombre_evento IN ('first_visit', 'add_to_cart', 'add_payment_info', 'purchase')\n",
    "),\n",
    "\n",
    "-- Aseguramos que cada usuario solo cuente si pasó por las etapas previas\n",
    "funnel_clean AS (\n",
    "    SELECT etapa, COUNT(DISTINCT id_usuario) AS usuarios_unicos\n",
    "    FROM funnel\n",
    "    WHERE id_usuario IN (SELECT id_usuario FROM funnel WHERE etapa = 'first_visit')\n",
    "    GROUP BY etapa\n",
    "),\n",
    "\n",
    "funnel_ordered AS (\n",
    "    SELECT \n",
    "        etapa,\n",
    "        usuarios_unicos,\n",
    "        CASE etapa\n",
    "            WHEN 'first_visit' THEN 1\n",
    "            WHEN 'add_to_cart' THEN 2\n",
    "            WHEN 'add_payment_info' THEN 3\n",
    "            WHEN 'purchase' THEN 4\n",
    "        END AS orden\n",
    "    FROM funnel_clean\n",
    ")\n",
    "\n",
    "SELECT\n",
    "    etapa,\n",
    "    usuarios_unicos,\n",
    "    LAG(usuarios_unicos) OVER (ORDER BY orden) AS usuarios_paso_anterior,\n",
    "    ROUND(\n",
    "        usuarios_unicos * 100.0 /\n",
    "        FIRST_VALUE(usuarios_unicos) OVER (ORDER BY orden)\n",
    "    , 2) AS tasa_conversion_global,\n",
    "    ROUND(\n",
    "        usuarios_unicos * 100.0 /\n",
    "        LAG(usuarios_unicos) OVER (ORDER BY orden)\n",
    "    , 2) AS tasa_conversion_paso\n",
    "FROM funnel_ordered\n",
    "ORDER BY orden;\n",
    "\n",
    "'''\n",
    "\n",
    "conversion = pd.read_sql(query_conversion, con=engine)\n",
    "conversion"
   ]
  },
